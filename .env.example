# Copy this file to a private .env only if you prefer environment variables.
# Do not commit real .env files.

SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# PKCE is the default and does not require a client secret.
SKULLIFY_USE_PKCE=1

# Optional playback/device preferences.
SKULLIFY_TERMINAL_PLAYER=librespot
SKULLIFY_TERMINAL_DEVICE_NAME=skullify-terminal
SKULLIFY_DEVICE_NAME=

# Built-ins: jellyfish, skull, skullify-wordmark.
SKULLIFY_ASCII=jellyfish
